# =========================
# API Configuration
# =========================

# Local development
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Production
NEXT_PUBLIC_API_URL=https://your-production-api-url.com

# Must match the API_SECRET in your backend .env
API_SECRET=your_api_secret_here


# =========================
# Firebase Client SDK
# =========================

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id


# =========================
# Firebase Admin SDK
# =========================

FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com

# IMPORTANT:
# Replace with your real private key and keep it secure.
# Do NOT commit real keys to GitHub.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
